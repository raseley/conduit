{
  "name": "conduit",
  "version": "2026.11.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Unofficial Rust+ companion client and Discord bot, packaged as a single Windows application.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "gen:proto": "node scripts/gen-proto.mjs",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo && rm -rf coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^24.9.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
