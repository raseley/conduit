{
  "name": "@conduit/desktop",
  "version": "2026.11.0",
  "license": "MIT",
  "private": true,
  "description": "Electron shell (the shipped .exe): headless coordinator + bootstrap wizard.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-renderer.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dist": "pnpm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@conduit/bot-core": "workspace:*",
    "@conduit/discord": "workspace:*",
    "@conduit/fcm": "workspace:*",
    "@conduit/rustplus-client": "workspace:*",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
